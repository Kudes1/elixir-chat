# Copy this file to .env before exposing the application beyond localhost.
PORT=4000
POSTGRES_DB=elixir_chat
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-password
# Generate with: openssl rand -base64 48
SECRET_KEY_BASE=q5YW0u9UN3Swa3JwhrElqWPbtONtO_KTXVPRoG4svE2PNhm6qBQwhaNIg6g0y6oZ
POOL_SIZE=10
POOL_COUNT=1
DB_SLOW_QUERY_MS=500
DB_QUEUE_WARN_MS=100
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=50
OUTBOX_RETENTION_DAYS=7
# Set this to the DNS name used to discover Erlang nodes when clustering is introduced.
DNS_CLUSTER_QUERY=
# Browser push notifications (Web Push). Generate with: mix generate.vapid.keys
# VAPID_PUBLIC_KEY and VAPID_PRIVATE_KEY must be a matching pair.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
# Comma-separated exact hosts or parent suffixes accepted from browser subscriptions.
WEB_PUSH_ALLOWED_HOST_SUFFIXES=fcm.googleapis.com,updates.push.services.mozilla.com,web.push.apple.com,notify.windows.com
