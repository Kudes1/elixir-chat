<Layouts.app flash={@flash} current_scope={@current_scope}>
  <main class="form-card">
    <h1 class="text-2xl font-bold">Подтвердите пароль администратора</h1>
    <.form for={@form} id="sudo-form" action={~p"/admin/reauth"} class="mt-6 space-y-4">
      <.input
        field={@form[:password]}
        id="sudo-password"
        type="password"
        label="Пароль"
        required
      />
      <.button id="sudo-submit" class="w-full">Продолжить</.button>
    </.form>
  </main>
</Layouts.app>
