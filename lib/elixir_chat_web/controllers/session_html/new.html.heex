<Layouts.app flash={@flash} current_scope={@current_scope}>
  <main class="form-card">
    <h1 class="text-3xl font-bold">Вход в Orbit</h1>
    <.form for={@form} id="login-form" action={~p"/login"} class="mt-8 space-y-4">
      <.input
        field={@form[:login]}
        id="login"
        label="Логин"
        autocomplete="username"
        required
      />
      <.input
        field={@form[:password]}
        id="password"
        type="password"
        label="Пароль"
        autocomplete="current-password"
        required
      />
      <.button id="login-submit" class="w-full">Войти</.button>
    </.form>
  </main>
</Layouts.app>
