<Layouts.app flash={@flash} current_scope={@current_scope}>
  <main id="chat-shell" class="chat-shell">
    <aside id="chat-sidebar" class="chat-sidebar">
      <header id="workspace-brand" class="sidebar-brand">
        <p class="sidebar-eyebrow">Рабочее пространство</p>
        <h1>Orbit</h1>
      </header>

      <nav id="channel-navigation" class="channel-navigation" aria-label="Каналы">
        <h2 class="sidebar-section-title">Каналы</h2>
        <div class="channel-list">
          <.link
            :for={channel <- @channels}
            id={"channel-#{channel.id}"}
            class={["channel-link", @channel && channel.id == @channel.id && "selected"]}
            patch={~p"/channels/#{channel.id}"}
          >
            <span aria-hidden="true">#</span>
            <span class="channel-name">{channel.name}</span>
          </.link>
        </div>
      </nav>

      <footer id="current-user" class="sidebar-profile">
        <.user_avatar
          name={@visitor_name}
          user_id={@current_scope.user.id}
          class="profile-avatar"
        />
        <div class="profile-details">
          <strong>{@visitor_name}</strong>
          <small id="current-user-login" class="current-user-login">
            @{@current_scope.user.login}
          </small>
        </div>
        <.link
          href={~p"/logout"}
          method="delete"
          id="logout-link"
          class="logout-link"
          aria-label="Выйти из Orbit"
        >
          Выйти
        </.link>
      </footer>
    </aside>

    <section :if={@channel} class="conversation" aria-label={"Канал #{@channel.name}"}>
      <header class="conversation-header">
        <div class="channel-heading">
          <h2 class="channel-title"><span aria-hidden="true">#</span> {@channel.name}</h2>
          <p>
            {@channel.description || "Командный разговор"}
          </p>
        </div>
        <span class="online-indicator"><i></i>{@online_count} в сети</span>
      </header>

      <div
        id="messages"
        class="message-list"
        phx-update="stream"
        phx-hook="MessageList"
        role="log"
        aria-live="polite"
      >
        <article
          :for={{dom_id, item} <- @streams.messages}
          id={dom_id}
          class={["message", item.continuation? && "message-continuation"]}
        >
          <.user_avatar
            :if={!item.continuation?}
            name={item.message.author_name}
            user_id={item.message.user_id}
            class="message-avatar"
          />
          <time :if={item.continuation?} class="message-continuation-time">
            {relative_time(item.message.inserted_at)}
          </time>
          <div class="message-content">
            <div :if={!item.continuation?} class="message-meta">
              <strong>{item.message.author_name}</strong>
              <button
                :if={item.message.user}
                id={"message-login-#{item.message.id}"}
                type="button"
                class="message-author-login"
                phx-click="insert_mention"
                phx-value-login={item.message.user.login}
                aria-label={"Упомянуть @#{item.message.user.login}"}
              >
                @{item.message.user.login}
              </button>
              <span class="message-meta-separator">·</span>
              <time>{relative_time(item.message.inserted_at)}</time>
            </div>
            <.message_body body={item.message.body} />
          </div>
        </article>
      </div>

      <.form for={@message_form} id="message-form" phx-submit="send_message" class="composer">
        <.input
          field={@message_form[:body]}
          id="message-body"
          type="textarea"
          class="chat-composer-input"
          rows="1"
          autocomplete="off"
          placeholder={"Написать в ##{@channel.name}"}
          aria-label="Сообщение"
          phx-hook="MessageComposer"
        />
        <button id="send-message" type="submit" aria-label="Отправить сообщение">
          <.icon name="hero-arrow-up" class="size-4" />
        </button>
      </.form>
    </section>

    <section :if={is_nil(@channel)} id="empty-chat" class="conversation empty-chat">
      <div>
        <h2>Пока нет доступных каналов</h2>
        <p>Добавьте публичный канал или запустите начальное заполнение базы.</p>
      </div>
    </section>
  </main>
</Layouts.app>
