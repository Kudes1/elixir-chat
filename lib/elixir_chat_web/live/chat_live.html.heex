<Layouts.app flash={@flash} current_scope={@current_scope}>
  <main
    id="chat-shell"
    class="chat-shell"
    phx-hook="SidebarResize"
    data-sidebar-default-width="264"
    data-sidebar-min-width="220"
    data-sidebar-max-width="480"
  >
    <.sidebar
      channels={@channels}
      channel={@channel}
      direct_conversation_id={@direct_conversation && @direct_conversation.id}
      direct_conversations={@direct_conversations}
      direct_search_open?={@direct_search_open?}
      direct_search_form={@direct_search_form}
      direct_search_results={@direct_search_results}
      channel_create_open?={@channel_create_open?}
      channel_catalog_open?={@channel_catalog_open?}
      current_user={@current_scope.user}
      visitor_name={@visitor_name}
      online_user_ids={@online_user_ids}
      unread_counts={@unread_counts}
      push_enabled?={@push_enabled?}
      vapid_public_key={@vapid_public_key}
    />
    <div
      id="sidebar-resizer"
      class="sidebar-resizer"
      role="separator"
      aria-label="Изменить ширину навигации"
      aria-controls="chat-sidebar"
      aria-orientation="vertical"
      aria-valuemin="220"
      aria-valuemax="480"
      aria-valuenow="264"
      data-sidebar-resizer
    >
    </div>
    <button
      id="sidebar-overlay"
      type="button"
      class="sidebar-overlay"
      aria-label="Закрыть навигацию"
      phx-click={close_sidebar()}
      style="display: none"
    ></button>

    <section
      :if={@channel}
      class="conversation"
      aria-label={
        if @current_other_user,
          do: "Личный диалог с #{@current_other_user.display_name}",
          else: "Канал #{@channel.name}"
      }
    >
      <.conversation_header
        channel={@channel}
        other_user={@current_other_user}
        online_count={@online_count}
        current_user={@current_scope.user}
        online_user_ids={@online_user_ids}
        muted?={MapSet.member?(@muted_channel_ids, @channel.id)}
      />

      <div class="message-window">
        <div
          id={"message-list-#{@channel.id}"}
          class="message-list"
          phx-update="stream"
          phx-hook="MessageList"
          data-has-older={to_string(@has_older_messages?)}
          data-has-newer={to_string(@has_newer_messages?)}
          data-at-latest={to_string(@at_latest?)}
          data-channel-id={@channel.id}
          data-newest-message-id={@newest_message && @newest_message.id}
          role="log"
          aria-live="polite"
        >
          <.message
            :for={{_dom_id, item} <- @streams.messages}
            item={item}
            current_user={@current_scope.user}
            channel={@channel}
            editing_message_id={@editing_message_id}
          />
        </div>
        <button
          :if={@pending_new_messages?}
          id="jump-to-latest"
          type="button"
          class="jump-to-latest"
          phx-click="jump_to_latest"
        >
          Новые сообщения <.icon name="hero-arrow-down" class="size-4" />
        </button>
      </div>

      <.composer
        form={@message_form}
        channel={@channel}
        other_user={@current_other_user}
        current_user_id={@current_scope.user.id}
      />
    </section>

    <section :if={is_nil(@channel)} id="empty-chat" class="conversation empty-chat">
      <button
        id="sidebar-toggle"
        type="button"
        class="mobile-sidebar-toggle empty-sidebar-toggle"
        aria-label="Открыть навигацию"
        aria-controls="chat-sidebar"
        aria-expanded="false"
        phx-click={open_sidebar()}
      >
        <.icon name="hero-bars-3" class="size-5" />
      </button>
      <div>
        <h2>Выберите разговор</h2><p>Откройте канал или начните личный диалог в меню слева.</p>
      </div>
    </section>

    <.channel_create :if={@channel_create_open?} form={@channel_form} />
    <.channel_catalog :if={@channel_catalog_open?} channels={@available_channels} />
    <.channel_settings
      :if={@channel_settings_open? && @channel && is_nil(@direct_conversation)}
      channel={@channel}
      current_user={@current_scope.user}
      form={@channel_form}
      invite_form={@invite_search_form}
      invite_results={@invite_search_results}
    />
    <.channel_members
      :if={@channel_members_open? && @channel && is_nil(@direct_conversation)}
      channel={@channel}
      current_user={@current_scope.user}
      memberships={@channel_memberships}
      online_user_ids={@online_user_ids}
    />
  </main>
</Layouts.app>
