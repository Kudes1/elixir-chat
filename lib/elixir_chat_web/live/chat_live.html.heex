<Layouts.app flash={@flash} current_scope={@current_scope}>
  <main id="chat-shell" class="chat-shell">
    <.sidebar
      channels={@channels}
      channel={@channel}
      direct_conversation_id={@direct_conversation && @direct_conversation.id}
      direct_conversations={@direct_conversations}
      direct_search_open?={@direct_search_open?}
      direct_search_form={@direct_search_form}
      direct_search_results={@direct_search_results}
      channel_catalog_open?={@channel_catalog_open?}
      current_user={@current_scope.user}
      visitor_name={@visitor_name}
    />
    <button
      id="sidebar-overlay"
      type="button"
      class="sidebar-overlay"
      aria-label="Закрыть навигацию"
      phx-click={close_sidebar()}
      style="display: none"
    ></button>

    <section
      :if={@channel}
      class="conversation"
      aria-label={
        if @current_other_user,
          do: "Личный диалог с #{@current_other_user.display_name}",
          else: "Канал #{@channel.name}"
      }
    >
      <.conversation_header
        channel={@channel}
        other_user={@current_other_user}
        online_count={@online_count}
        current_user={@current_scope.user}
      />

      <section :if={@message_search_open?} id="message-search-panel" class="message-search-panel">
        <header>
          <strong>Поиск в разговоре</strong>
          <button
            id="close-message-search"
            type="button"
            phx-click="close_message_search"
            aria-label="Закрыть поиск"
          >
            <.icon name="hero-x-mark" class="size-4" />
          </button>
        </header>
        <.form for={@message_search_form} id="message-search-form" phx-submit="search_messages">
          <.input
            field={@message_search_form[:query]}
            id="message-search-query"
            type="search"
            label="Слова в сообщении"
            autocomplete="off"
          />
          <button id="submit-message-search" type="submit">Найти</button>
        </.form>
        <div id="message-search-results" class="message-search-results">
          <button
            :for={message <- @message_search_results}
            id={"message-search-result-#{message.id}"}
            type="button"
            phx-click="jump_to_message"
            phx-value-message-id={message.id}
          >
            <span><strong>{message.author_name}</strong><time>{Calendar.strftime(
              message.inserted_at,
              "%d.%m.%Y %H:%M"
            )}</time></span>
            <p>{message_snippet(message.body)}</p>
          </button>
          <p :if={@message_search_results == []}>Совпадений нет</p>
        </div>
        <button
          :if={@message_search_has_more?}
          id="load-more-message-results"
          type="button"
          phx-click="load_more_message_results"
        >Показать ещё</button>
      </section>

      <div class="message-window">
        <div
          id="messages"
          class="message-list"
          phx-update="stream"
          phx-hook="MessageList"
          data-has-older={to_string(@has_older_messages?)}
          data-has-newer={to_string(@has_newer_messages?)}
          role="log"
          aria-live="polite"
        >
          <.message
            :for={{_dom_id, item} <- @streams.messages}
            item={item}
            highlighted_message_id={@highlighted_message_id}
          />
        </div>
        <button
          :if={@pending_new_messages?}
          id="jump-to-latest"
          type="button"
          class="jump-to-latest"
          phx-click="jump_to_latest"
        >
          Новые сообщения <.icon name="hero-arrow-down" class="size-4" />
        </button>
      </div>

      <.composer form={@message_form} channel={@channel} other_user={@current_other_user} />
    </section>

    <section :if={is_nil(@channel)} id="empty-chat" class="conversation empty-chat">
      <button
        id="sidebar-toggle"
        type="button"
        class="mobile-sidebar-toggle empty-sidebar-toggle"
        aria-label="Открыть навигацию"
        aria-controls="chat-sidebar"
        aria-expanded="false"
        phx-click={open_sidebar()}
      >
        <.icon name="hero-bars-3" class="size-5" />
      </button>
      <div>
        <h2>Выберите разговор</h2><p>Откройте канал или начните личный диалог в меню слева.</p>
      </div>
    </section>

    <.channel_catalog
      :if={@channel_catalog_open?}
      form={@channel_form}
      channels={@available_channels}
    />
    <.channel_settings
      :if={@channel_settings_open? && @channel && is_nil(@direct_conversation)}
      channel={@channel}
      current_user={@current_scope.user}
      form={@channel_form}
      memberships={@channel_memberships}
      invite_form={@invite_search_form}
      invite_results={@invite_search_results}
    />
  </main>
</Layouts.app>
